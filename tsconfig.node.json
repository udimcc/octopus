{
  // Node/Electron-main side: main, preload, and the process-agnostic hexagonal
  // layers (domain/application/ports/adapters) plus shared contracts and tests.
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/domain/**/*",
    "src/application/**/*",
    "src/ports/**/*",
    "src/adapters/**/*",
    "src/shared/**/*",
    "test/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  }
}
