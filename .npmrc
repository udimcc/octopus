# Project Octopus — air-gapped install configuration.
#
# We operate on an internal network with NO access to github.com or the public
# npm registry. Packages resolve through the internal Artifactory npm proxy, and
# Electron's Chromium binary (normally downloaded from GitHub releases by
# @electron/get) is redirected to the internal Artifactory "github-remote" mirror.
#
# The user's ~/.npmrc already sets `registry`, `cafile` and `strict-ssl`; they are
# repeated here so a fresh checkout installs correctly regardless of user config.

registry=https://rt-isp.israel.final/artifactory/api/npm/npm-remote/
@final:registry=https://artifactory.israel.final/artifactory/api/npm/npm-local/
cafile=/etc/ssl/certs/ca-certificates.crt
strict-ssl=true

# @electron/get appends "v<ver>/electron-v<ver>-<platform>-<arch>.zip" to this base.
electron_mirror=https://rt-isp.israel.final/artifactory/github-remote/electron/electron/releases/download/

# node-gyp header source. node-pty is N-API (node-addon-api) and is COMPILED FROM
# SOURCE against the host Node's headers — mirrored here, since nodejs.org is
# unreachable. node-gyp appends "v<ver>/node-v<ver>-headers.tar.gz" to this base.
# (better-sqlite3 is V8-direct and cannot be compiled against Electron's ABI
# offline — Electron's node-headers are not on the mirror — so it uses a prebuilt
# binary instead; see scripts/rebuild-natives.mjs, run via the postinstall hook.)
disturl=https://rt-isp.israel.final/artifactory/nodejs-clients-remote

# electron-builder downloads its own helper binaries (app-builder, etc.) from
# GitHub too. Its mirror is an ENV var, not an npm setting, so it is documented
# here and set at build time (see electron-builder.yml notes). Uncomment/point at
# a verified Artifactory generic repo before producing packaged installers (V1+):
# ELECTRON_BUILDER_BINARIES_MIRROR=<artifactory-generic>/electron-userland/electron-builder-binaries/
