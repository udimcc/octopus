#!/bin/sh
# octopus-cli: command-line client for a running Octopus app (talks to its control socket).
#
# Runs the bundled Electron binary as plain Node (ELECTRON_RUN_AS_NODE=1, the same trick
# the app uses to launch octopusd) on the CLI bundle `out/main/cli.js`, which lives inside
# app.asar (electron-builder.yml packs out/** into it; Electron's patched fs reads asar).
#
# Packaging: this script cannot be exec'd from inside app.asar, so scripts/release.mjs
# stages a copy NEXT TO the `octopus` binary (linux-unpacked/octopus-cli), and install.sh
# copies that into the program dir and symlinks ~/.local/bin/octopus-cli to it. macOS: see the
# Darwin branch below.
#
# Dev (no install): ELECTRON_RUN_AS_NODE=1 npx electron out/main/cli.js "$@"
# (after `npm run build`).

set -eu

if [ "$(uname -s)" = Darwin ]; then
  # macOS: this file is staged at Octopus.app/Contents/Resources/octopus-cli (by
  # electron-builder.mac.yml's extraResources; Contents/MacOS may hold only Mach-O files or the
  # code signature breaks), and install-mac.sh symlinks ~/.local/bin/octopus-cli to it. Resolve
  # the symlink chain by hand: BSD readlink has no -f before macOS 12.3.
  SELF=$0
  while [ -L "$SELF" ]; do
    LINK=$(readlink -- "$SELF")
    case "$LINK" in
      /*) SELF=$LINK ;;
      *) SELF=$(dirname -- "$SELF")/$LINK ;;
    esac
  done
  RESOURCES_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd -P)
  ELECTRON_RUN_AS_NODE=1 exec "$RESOURCES_DIR/../MacOS/Octopus" "$RESOURCES_DIR/app.asar/out/main/cli.js" "$@"
fi

# Follow the ~/.local/bin symlink to the real file (Linux: GNU readlink -f).
SELF=$(readlink -f -- "$0")
PROGRAM_DIR=$(dirname -- "$SELF")

ELECTRON_RUN_AS_NODE=1 exec "$PROGRAM_DIR/octopus" "$PROGRAM_DIR/resources/app.asar/out/main/cli.js" "$@"
